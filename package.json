{
  "name": "@pic-standard/pic-standard-ts",
  "version": "0.9.1",
  "description": "TypeScript implementation of PIC Standard (Provenance & Intent Contracts), passing the shared conformance corpus for canonicalization, core, and trust_sanitization modes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "schemas/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pic-standard",
    "pic",
    "provenance",
    "intent-contracts",
    "ai-safety",
    "ai-agents",
    "tool-calling",
    "fail-closed",
    "verifier",
    "typescript"
  ],
  "homepage": "https://github.com/pic-standard/pic-standard-ts#readme",
  "bugs": {
    "url": "https://github.com/pic-standard/pic-standard-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pic-standard/pic-standard-ts.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Fabio Marcello Salvadori",
    "email": "fabio@madeinpluto.com"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "copy-schema": "node scripts/copy-schema.mjs",
    "prebuild": "npm run copy-schema",
    "pretest": "npm run copy-schema",
    "pretest:watch": "npm run copy-schema",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packed": "node scripts/test-packed-artifact.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "conformance": "npm run build && node dist/run.js --manifest vendor/pic-standard/conformance/manifest.json --filter-mode canonicalization --filter-mode core --filter-mode trust_sanitization",
    "conformance:json": "npm run build && node dist/run.js --manifest vendor/pic-standard/conformance/manifest.json --filter-mode canonicalization --filter-mode core --filter-mode trust_sanitization --json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^4.0.0"
  }
}
