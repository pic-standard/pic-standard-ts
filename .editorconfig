# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: preserve trailing spaces (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false

# Windows batch scripts require CRLF (matches .gitattributes).
[*.{bat,cmd}]
end_of_line = crlf
